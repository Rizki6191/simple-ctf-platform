generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String       @id @default(uuid())
  username  String       @unique
  password  String
  role      Role         @default(USER)

  submissions Submission[]

  createdAt DateTime     @default(now())
}

model Submission {
  id           String   @id @default(uuid())

  userId       String
  challengeId  String   // nama folder challenge

  submittedFlag String
  isCorrect     Boolean

  user         User     @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([challengeId])
  @@unique([userId, challengeId]) // 1 user 1 solve
}

enum Role {
  USER
  ADMIN
}
